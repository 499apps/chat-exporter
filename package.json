{
    "name":  "convo-keeper",
    "description":  "Export your AI chat conversations to Markdown, JSON or PDF, entirely on your device.",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "wxt",
                    "build":  "wxt build",
                    "zip":  "wxt zip",
                    "postinstall":  "wxt prepare",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint .",
                    "test":  "vitest run",
                    "check":  "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm test"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.17.0",
                            "@types/node":  "^22.20.5",
                            "eslint":  "^9.17.0",
                            "jsdom":  "^25.0.1",
                            "typescript":  "^5.7.2",
                            "typescript-eslint":  "^8.18.0",
                            "vitest":  "^4.1.11",
                            "wxt":  "^0.21.4"
                        }
}